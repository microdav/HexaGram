# HexaGram — bloc à fusionner dans /etc/caddy/Caddyfile sur la VM.
#
# Préalables :
#   • DNS A record `hexagram.davidlardy.com` -> IP publique Freebox
#   • Ports 80 et 443 forwardés sur la VM (déjà en place pour micromoney)
#   • Caddy provisionne le cert Let's Encrypt automatiquement (HTTP-01)
#
# IMPORTANT : tous les blocs doivent utiliser handle{} pour que
# try_files (file_server) n'intercepte pas les requêtes /api/*.

hexagram.davidlardy.com {
    encode zstd gzip

    handle /api/* {
        reverse_proxy localhost:3001
    }

    handle {
        root * /opt/hexagram/app
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
}
